num_bands        =    4

num_iter         =  100
dis_num_iter     =  100

iprint           =    2
num_dump_cycles  =   10
num_print_cycles =   10


opfm = .true.
opfm_write_w_matrix = .true.

begin projections
!! !! Bond-centred s-orbitals
f=-0.125,-0.125, 0.375:s
f= 0.375,-0.125,-0.125:s
f=-0.125, 0.375,-0.125:s
f=-0.125,-0.125,-0.125:s
!! !! Atom-centred sp3-orbitals
Si1:sp3   !! incorrect orientation
Si2:sp3   !! correct orientation
!! !! s and p orbitals on Si1 and Si2
Si1:s,p
Si2:s,p
!! !! s and p orbitals on 4 neighbors of Si1
f= 0.00, 0.00, 0.00:s,p
f= 0.00, 1.00, 0.00:s,p
f=-1.00, 1.00, 0.00:s,p
f= 0.00, 1.00,-1.00:s,p
end projections

num_wann        =   4
!! select_projections 1 2 3 4         !! bond-centered s-orbitals
!! select_projections 5-8             !! sp3 incorrect orientation
!! select_projections 9-12            !! sp3 correct orientation
!! select_projections 13-16           !! s,p on Si1
!! select_projections 17-20           !! s,p on Si2
select_projections 13-16 , 21-36   !! s,p orbitals on Si1 and its 4 neighbors

begin unit_cell_cart
 bohr
-5.10   0.00   5.10
 0.00   5.10   5.10
-5.10   5.10   0.00
end unit_cell_cart


begin atoms_frac
Si1 -0.25  0.75  -0.25
Si2  0.00  0.00   0.00
end atoms_frac


mp_grid  =  4 4 4

